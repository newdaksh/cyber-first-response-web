{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build",
    "start": "vinext start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write . --ignore-path .prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-unknown",
    "test": "pnpm test:unit",
    "test:core": "node --experimental-strip-types --test tests/core.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/core.test.mjs tests/security.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/core.test.mjs tests/security.test.mjs",
    "test:integration": "playwright test e2e/api.spec.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/workflow.spec.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
